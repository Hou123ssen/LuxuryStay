# ============================================================
# FRONTEND - React (Vite) Environment Variables Example
# ============================================================
# Copy this file to .env (development) or .env.production
# and replace the placeholder values with real URLs.
#
# IMPORTANT: 
#   • NEVER commit .env files to GitHub
#   • Variables exposed to the browser MUST start with VITE_
#   • To verify ignored files: git status
# ------------------------------------------------------------

# ------------------------------------------------- Local Dev
# When running Laravel with `php artisan serve` (default port 8000)
VITE_API_URL=http://localhost:8000/api

# If you prefer 127.0.0.1 explicitly:
# VITE_API_URL=http://127.0.0.1:8000/api

# ------------------------------------------------- Production
# Example (uncomment and fill when deploying):
# VITE_API_URL=https://luxurystay.example.com/api

